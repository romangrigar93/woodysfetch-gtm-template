___SANDBOXED_JS_FOR_WEB_TEMPLATE___

// Woody's Fetch — Conversion Tracking Tag
// https://woodysfetch.com

const getCookieValues = require('getCookieValues');
const copyFromDataLayer = require('copyFromDataLayer');
const injectScript = require('injectScript');
const JSON = require('JSON');
const setInWindow = require('setInWindow');
const copyFromWindow = require('copyFromWindow');
const makeString = require('makeString');
const makeNumber = require('makeNumber');
const log = require('logToConsole');
const decodeUriComponent = require('decodeUriComponent');
const getType = require('getType');
const apiKey = data.apiKey;
const apiUrl = 'https://woodysfetch.com/api/v1/analytics/conversion';
const debug = data.debugMode;

// No consent check — we send data to our own server, not Google.
// GTM consent mode is handled by the shop's own GA4 tags.

runTag();

function runTag() {
  // ---- Read tracking cookie (_wf_tracking) ----
  var tracking = {};
  var cookieValues = getCookieValues('_wf_tracking');
  if (cookieValues.length > 0 && cookieValues[0]) {
    var decoded = decodeUriComponent(cookieValues[0]);
    var parsed = JSON.parse(decoded);
    if (getType(parsed) === 'object') {
      tracking = parsed;
    }
  }

  // Extract session IDs from cookie
  var sessionIds = [];
  var sessions = tracking.s;
  if (sessions) {
    if (getType(sessions) === 'object') {
      var keys = ['wf_session_id', 'wfg_session_id', 'wfr_session_id'];
      for (var k = 0; k < keys.length; k++) {
        if (sessions[keys[k]]) {
          sessionIds.push(sessions[keys[k]]);
        }
      }
    }
  }

  // Extract clicked product IDs from cookie
  var clickedProductIds = [];
  if (tracking.c && getType(tracking.c) === 'array') {
    for (var ci = 0; ci < tracking.c.length; ci++) {
      clickedProductIds.push(makeString(tracking.c[ci]));
    }
  }

  if (debug) {
    log('[WF] Session IDs (cookie):', JSON.stringify(sessionIds));
    log('[WF] Clicked product IDs (cookie):', JSON.stringify(clickedProductIds));
  }

  // ---- Get current dataLayer event ----
  var eventName = copyFromDataLayer('event');

  // Custom event name overrides
  var purchaseEventName = data.customPurchaseEvent || 'purchase';
  var addToCartEventName = data.customAddToCartEvent || 'add_to_cart';

  var hasQueuedRequest = false;

  // ---- Purchase tracking ----
  if (data.trackPurchase && eventName === purchaseEventName) {
    var ecommerce = copyFromDataLayer('ecommerce') || {};
    var items = ecommerce.items || [];

    // Order ID: custom override → dataLayer
    var orderId = data.customOrderId
      ? makeString(data.customOrderId)
      : makeString(ecommerce.transaction_id || '');

    // Order value: custom override → dataLayer
    var orderValue =
      data.customOrderValue !== undefined && data.customOrderValue !== ''
        ? makeNumber(data.customOrderValue)
        : makeNumber(ecommerce.value || 0);

    // Currency: custom override → dataLayer → CZK fallback
    var currency = data.customCurrency || ecommerce.currency || 'CZK';

    // Product IDs & quantities: custom override → dataLayer items
    var productIds = [];
    var quantities = [];

    if (data.customProductIds && getType(data.customProductIds) === 'array') {
      productIds = data.customProductIds;
      quantities =
        data.customQuantities && getType(data.customQuantities) === 'array'
          ? data.customQuantities
          : [];
    } else {
      for (var i = 0; i < items.length; i++) {
        productIds.push(makeString(items[i].item_id || items[i].id || ''));
        var qty = makeNumber(items[i].quantity);
        quantities.push(qty > 0 ? qty : 1);
      }
    }

    var purchasePayload = {
      event_type: 'purchase',
      session_ids: sessionIds,
      order_id: orderId,
      order_value: orderValue,
      currency: currency,
      product_ids: productIds,
      quantities: quantities,
      clicked_product_ids: clickedProductIds,
    };

    if (debug) log('[WF] Purchase payload:', JSON.stringify(purchasePayload));
    queueRequest(purchasePayload);
    hasQueuedRequest = true;
  }

  // ---- Add to Cart tracking ----
  if (data.trackAddToCart && eventName === addToCartEventName) {
    var ecommerceAtc = copyFromDataLayer('ecommerce') || {};
    var atcItems = ecommerceAtc.items || [];
    var firstItem = atcItems.length > 0 ? atcItems[0] : {};

    // Product ID: custom override → dataLayer
    var productId = data.customProductId
      ? makeString(data.customProductId)
      : makeString(firstItem.item_id || firstItem.id || '');

    // Product name: custom override → dataLayer
    var productName = data.customProductName || firstItem.item_name || firstItem.name || '';

    // Quantity: custom override → dataLayer
    var quantity =
      data.customQuantity !== undefined && data.customQuantity !== ''
        ? makeNumber(data.customQuantity)
        : makeNumber(firstItem.quantity || 1);

    if (quantity < 1) quantity = 1;

    var atcPayload = {
      event_type: 'add_to_cart',
      session_ids: sessionIds,
      product_id: productId,
      product_name: productName,
      quantity: quantity,
      clicked_product_ids: clickedProductIds,
    };

    if (debug) log('[WF] Add to Cart payload:', JSON.stringify(atcPayload));
    queueRequest(atcPayload);
    hasQueuedRequest = true;
  }

  // ---- Inject helper script ----
  // Helper handles: POST requests (sandbox can't POST), widget button clicks,
  // and enriches payloads with sessionStorage data (sandbox can't read sessionStorage)
  if (hasQueuedRequest || data.trackWidgetClicks) {
    injectScript(
      'https://woodysfetch.com/js/gtm-helper.js?v=2',
      data.gtmOnSuccess,
      data.gtmOnFailure,
      'woodysFetchGtmHelper'
    );
  } else {
    data.gtmOnSuccess();
  }
}

function queueRequest(payload) {
  var pending = copyFromWindow('__wfGtmPending');
  if (!pending || getType(pending) !== 'array') {
    pending = [];
  }
  pending.push({
    url: apiUrl,
    apiKey: apiKey,
    payload: payload,
  });
  setInWindow('__wfGtmPending', pending);
}


