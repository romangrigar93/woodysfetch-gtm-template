___TESTS___

scenarios:
- name: Purchase event with GA4 dataLayer
  code: |-
    const mockData = {
      apiKey: 'test_api_key_123',
      trackPurchase: true,
      trackAddToCart: false,
      trackWidgetClicks: false,
      debugMode: false
    };

    mock('copyFromDataLayer', function(key) {
      if (key === 'event') return 'purchase';
      if (key === 'ecommerce') return {
        transaction_id: 'ORD-001',
        value: 1299.00,
        currency: 'CZK',
        items: [
          { item_id: 'SKU-100', item_name: 'Product A', quantity: 2, price: 499.00 },
          { item_id: 'SKU-200', item_name: 'Product B', quantity: 1, price: 301.00 }
        ]
      };
      return undefined;
    });

    mock('getCookieValues', function(name) {
      if (name === '_wf_tracking') {
        return ['%7B%22s%22%3A%7B%22wf_session_id%22%3A%22wf_abc123%22%7D%2C%22c%22%3A%5B%22SKU-100%22%5D%7D'];
      }
      return [];
    });

    let queuedData;
    mock('setInWindow', function(key, value) {
      if (key === '__wfGtmPending') queuedData = value;
    });
    mock('copyFromWindow', function() { return null; });

    let injectedUrl;
    mock('injectScript', function(url, onSuccess) {
      injectedUrl = url;
      onSuccess();
    });

    runCode(mockData);

    assertThat(queuedData).isNotNull();
    assertThat(queuedData.length).isEqualTo(1);
    assertThat(queuedData[0].payload.event_type).isEqualTo('purchase');
    assertThat(queuedData[0].payload.order_id).isEqualTo('ORD-001');
    assertThat(queuedData[0].payload.order_value).isEqualTo(1299);
    assertThat(queuedData[0].payload.product_ids.length).isEqualTo(2);
    assertThat(queuedData[0].payload.session_ids.length).isEqualTo(1);
    assertThat(injectedUrl).isEqualTo('https://woodysfetch.com/js/gtm-helper.js?v=2');
